# ══════════════════════════════════════════════════════════════════
# SOC Incident Report Protection — the ONE env file
#
#   1. Copy to .env:        cp .env.example .env
#   2. Fill in the values below
#   3. Sync to packages:    pnpm run env:sync
#      (also runs automatically before `pnpm run dev`)
#
# frontend/.env.local and backend/.env are GENERATED from this file —
# never edit them by hand. Reference: docs/ENV-VARS.md
#
# TideCloak is the only authentication provider — see the
# NEXT_PUBLIC_TIDECLOAK_* section below and docs/TIDECLOAK-LOCAL.md. Firebase
# Authentication is not used anywhere in this app.
#
# Firestore is reserved for future server-side backend features (emergency-
# access request, approval, expiry, audit history). The browser never
# connects to Firestore directly (firebase/firestore.rules denies all direct
# client access) — only the Express backend does, via Firebase Admin, after
# the TideCloak auth middleware has verified and authorized the request.
# A Firebase project and FIREBASE_SERVICE_ACCOUNT_KEY_BASE64 below are only
# needed once a Firestore-backed feature is implemented; deployed Cloud
# Functions use Application Default Credentials instead and need no env var.
# ══════════════════════════════════════════════════════════════════

# ── Firebase (backend Firestore access only — optional for local dev) ─
# Service account JSON, base64-encoded. SERVER-ONLY SECRET — never commit,
# and never expose to the frontend. Only needed to run the backend locally
# against a real Firestore project; deployed Cloud Functions do not read
# this variable (they use Application Default Credentials instead — see
# backend/src/lib/firebase.ts). Not required to run the app otherwise.
# Firebase Console → Project settings → Service accounts → Generate new private key
#   macOS (BSD base64):  base64 -i service-account.json | tr -d '\n'
#   Linux (GNU base64):  base64 -w 0 service-account.json
#   PowerShell:          [Convert]::ToBase64String([IO.File]::ReadAllBytes('C:\path\service-account.json'))
FIREBASE_SERVICE_ACCOUNT_KEY_BASE64=

# ── App ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=

# ── Backend API ─────────────────────────────────────────────────────
# Allowed CORS origin for /api (empty = all cross-origin requests denied)
CORS_ORIGIN=
# Local port for the Functions API
PORT=5001
# Base URL the frontend uses to call the backend Express API directly
# (e.g. GET /api/incidents). Public — same trust level as NEXT_PUBLIC_APP_URL.
NEXT_PUBLIC_API_URL=http://localhost:5001

# ── Claude Code MCP (optional) ──────────────────────────────────────
# Google Stitch design-to-code — https://stitch.withgoogle.com/settings
STITCH_API_KEY=

# ── TideCloak local dev (SOC Incident Report Protection PoC) ─────────
# Bootstrap admin for the LOCAL TideCloak container only (docker-compose.tidecloak.yml).
# NOT synced to frontend/backend — Docker Compose reads these straight from .env.
# Choose your own username and a strong password in your local .env. Both are
# required before `pnpm run tidecloak:start` — there is no default for either.
# Never commit real values; never put them on the command line or in a script.
# See docs/TIDECLOAK-LOCAL.md.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=

# ── TideCloak frontend auth (public OIDC client config) ─────────────
# Consumed by the browser via the TideCloak SDK. NOT secret — this is a public
# OIDC client's connection details. Synced to frontend/.env.local automatically
# (all NEXT_PUBLIC_* keys are). Fill these from the realm + client created in
# TideCloak (see docs/TIDECLOAK-LOCAL.md).
NEXT_PUBLIC_TIDECLOAK_AUTH_SERVER_URL=http://localhost:8080
NEXT_PUBLIC_TIDECLOAK_REALM=soc-incident-report-protection
NEXT_PUBLIC_TIDECLOAK_CLIENT_ID=soc-incident-report-protection-app
# Optional — defaults to 'external' (correct for localhost) if unset
NEXT_PUBLIC_TIDECLOAK_SSL_REQUIRED=external
# Optional — the SDK defaults to <app origin>/auth/redirect if unset
NEXT_PUBLIC_TIDECLOAK_REDIRECT_URI=

# ── TideCloak backend auth (server-side JWT verification) ───────────
# The full Tide adapter JSON (as a single-line string), used by the Express
# backend to verify TideCloak access tokens locally (embedded JWKS — no
# remote JWKS fetch). SERVER-ONLY. Not synced to the frontend. If unset, the
# backend falls back to data/tidecloak.json (gitignored, local-only) and
# fails closed (401s) if neither is present or valid.
# Never commit a real value — placeholder only, see docs/BACKEND.md.
CLIENT_ADAPTER=

# ── Playwright local-tidecloak E2E tests (optional) ──────────────────
# Only needed to run `pnpm run test:e2e:local-tidecloak` against a running
# local TideCloak container. Must be a real test account already created in
# the realm — Playwright does not provision one. NOT synced to
# frontend/.env.local (scripts/sync-env.js does not reference them); read
# directly from the process environment by the Playwright spec files. Never
# commit real values. See docs/TESTING.md.
E2E_TIDECLOAK_USERNAME=
E2E_TIDECLOAK_PASSWORD=
