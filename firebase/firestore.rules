rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Server-only Firestore ────────────────────────────────────────────
    //
    // All current and future Firestore access (emergency-access requests,
    // approvals, expiry, audit history, etc.) happens server-side, from the
    // Express backend (backend/src/lib/firebase.ts, `adminDb`), only after
    // the TideCloak auth middleware (backend/src/middleware/auth.ts) has
    // verified the caller's TideCloak access token and checked authorization
    // for the requested operation.
    //
    // The Firebase Admin SDK used by the backend bypasses these security
    // rules entirely — they exist only to govern the client Firestore SDK,
    // which this application does not use. TideCloak is the sole
    // authentication provider; the app never signs a user into Firebase
    // Authentication, so `request.auth` is always null here regardless of
    // whether a user is authenticated with TideCloak. Deny everything by
    // default so a direct browser connection to Firestore can never read or
    // write any document.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
